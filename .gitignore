__pycache__/
.pytest_cache/
.venv/
*.pyc

# build / packaging
*.egg-info/
dist/
build/

# OS / editor
.DS_Store

# local logs
*.log

data/shared_state/*.db
source/*.db

# runtime market cache / generated data
data/market_overview/*.json
data/reference/china_admin_locations.json
data/reference/stock_basic_info.csv
data/reference/stock_basic_info.json

# local runtime state
data/shared_state/*
!data/shared_state/.gitkeep

# generated site outputs
outputs/*.html
outputs/html/*.html
outputs/market/*.html
outputs/dragon_tiger/*.json
outputs/dragon_tiger/*.html
outputs/dragon_tiger/*.md
outputs/app/data/*.csv
outputs/app/data/*.json
outputs/app/data/*.js
outputs/app/*.html
!outputs/.gitkeep
!outputs/app/.gitkeep
!outputs/app/data/.gitkeep
!outputs/html/.gitkeep
!outputs/market/.gitkeep
!outputs/dragon_tiger/.gitkeep

# 分片产物需要入库（主索引 + 按日期分片），单文件远小于 100MB 上限。
# 不加这条，outputs/app/data/*.json 的忽略规则会把分片一并吞掉。
!outputs/app/data/shards/
!outputs/app/data/shards/**
